<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Metadados de pacote NuGet -->
    <PackageId>Sieg.Auth</PackageId>
    <Version>1.1.1</Version>
    <Authors>VictorTrovao</Authors>
    <Company>VictorTrovao</Company>
    <Description>SDK de autenticação OAuth 2.0 da SIEG para sistemas emissores de nota fiscal.</Description>
    <PackageTags>SIEG;OAuth2;Fiscal;SDK;NotasFiscais</PackageTags>
    <RepositoryUrl>https://github.com/VictorTrovao97/OAuth2.0_Sieg</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/VictorTrovao97/OAuth2.0_Sieg</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Vincular o README raiz ao pacote NuGet -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
  </ItemGroup>

  <!-- Incluir o arquivo fisicamente na raiz do .nupkg gerado -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

